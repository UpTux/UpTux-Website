{
  "name": "uptux-website",
  "version": "1.0.0",
  "description": "Website von UpTux (uptux.de)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:preview": "vite build --mode preview",
    "serve": "vite preview",
    "build:github-io": "SITE_BASE=/UpTux-Website/ npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module"
}
